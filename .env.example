# Spotify API Configuration (for future integration)
# Get these from https://developer.spotify.com/dashboard

NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: Add your own custom environment variables
NEXT_PUBLIC_APP_NAME=365 Days of Loving You
NEXT_PUBLIC_COUPLE_NAMES=A & M
NEXT_PUBLIC_ANNIVERSARY_DATE=2026-02-16
